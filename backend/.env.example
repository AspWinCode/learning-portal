# Backend: скопируй в .env и подставь свои значения.
# Один и тот же код — различаются только значения ниже для локальной разработки и продакшена.

# --- LOCAL (разработка) ---
# DATABASE_URL=postgresql://learning_user:ТВОЙ_ПАРОЛЬ@localhost:5432/learning_portal
# SECRET_KEY=dev-secret-key-min-32-characters-long-change-in-production
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# APP_ENV=development

# --- PRODUCTION (сервер) ---
# DATABASE_URL=postgresql://learning_user:ПАРОЛЬ@db:5432/learning_portal
# SECRET_KEY=длинный-секретный-ключ-не-менее-32-символов
# CORS_ORIGINS=https://твой-домен.ru
# APP_ENV=production

# Используемые переменные (раскомментируй и заполни один из блоков выше или задай здесь):
DATABASE_URL=postgresql://learning_user:change_me_strong_password@localhost:5432/learning_portal
SECRET_KEY=dev-secret-key-min-32-characters-long-change-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
