# Caddy слушает plain HTTP — SSL терминирует системный nginx
# nginx проксирует tirskix.space → 127.0.0.1:8090 → этот контейнер
http://{$DOMAIN} {
    encode gzip zstd

    # Backend API: все /api/* на backend без обрезки пути (path сохраняется)
    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }

    # Frontend (static SPA)
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

# GDevelop — plain HTTP, nginx проксирует gdevelop.tirskix.space → 127.0.0.1:8090
http://gdevelop.tirskix.space {
    encode gzip zstd

    handle_path /gdevelop-resources/* {
        reverse_proxy gdevelop-resources:3000
    }

    handle {
        reverse_proxy gdevelop-gdevelop-web:80
    }
}