https://{$DOMAIN} {
    encode gzip zstd

    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

gdevelop.tirskix.space {
    encode gzip zstd

    handle_path /gdevelop-resources/* {
        reverse_proxy gdevelop-resources:3000
    }

    handle {
        reverse_proxy gdevelop-web:80
    }
}

arenabattle.tirskix.space {
    encode gzip zstd
    reverse_proxy arena_battle-frontend-1:80
}

djam.tirskix.space {
    encode gzip zstd

    @api {
        path /api/* /socket.io/*
    }
    handle @api {
        reverse_proxy game-game-api:4000
    }

    handle /uploads/* {
        reverse_proxy game-game-api:4000
    }

    handle {
        reverse_proxy game-game-web:3000
    }
}
