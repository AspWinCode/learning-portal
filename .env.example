# Copy to .env and fill in before: docker compose up -d --build
# Used by docker-compose for deployment.

POSTGRES_PASSWORD=change_me_strong_password
SECRET_KEY=change_me_min_32_chars_change_me_min_32_chars
CORS_ORIGINS=https://example.com
DOMAIN=example.com

# Optional: Telegram bot (enable with: docker compose --profile telegram up -d --build)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# Optional: SMS Gateway. InfiniReach: https://infinireach.io/docs/api
# InfiniReach:
#   SMS_GATEWAY_PROVIDER=infinireach
#   SMS_GATEWAY_BASE_URL=https://api.infinireach.io
#   SMS_GATEWAY_TOKEN=ваш_X-API-Key_из_дашборда
#   SMS_GATEWAY_FROM=+79XXXXXXXXX  (номер SIM зарегистрированного устройства, E.164)
# Другой gateway (generic):
#   SMS_GATEWAY_BASE_URL=https://your-gateway-url
#   SMS_GATEWAY_TOKEN=your-token
#   SMS_GATEWAY_DEVICE_ID=
#   SMS_GATEWAY_SEND_PATH=3rdparty/v1/messages

# Optional: MAX мессенджер. Два режима (можно один или оба):
# 1) Бот: https://dev.max.ru/docs-api — сообщения от бота. Токен: business.max.ru → Чат-боты → Интеграция
#    MAX_API_BASE_URL=https://platform-api.max.ru
#    MAX_BOT_TOKEN=your-bot-token
# 2) Личный аккаунт (бесплатно): GREEN-API — тариф MAX Developer, до 3 чатов. Привязка в ЛК console.green-api.com
#    GREEN_API_BASE_URL=https://XXXX.api.green-api.com
#    GREEN_API_ID_INSTANCE=ваш_id_инстанса
#    GREEN_API_TOKEN=ваш_токен_инстанса
# 3) Личный аккаунт (платно): api-messenger.com — привязка по QR в настройках CRM
#    MAX_PERSONAL_BASE_URL=https://app.api-messenger.com/max-v1
#    MAX_PERSONAL_TOKEN=your-personal-token
