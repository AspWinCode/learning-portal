{
	# Email is optional but recommended for Let's Encrypt rate-limit recovery:
	# email you@example.com
}

http://{$DOMAIN} https://{$DOMAIN} {
	encode gzip zstd

	# Backend API
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Frontend (static SPA)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}


