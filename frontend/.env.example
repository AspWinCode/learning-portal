# Frontend: скопируй в .env и подставь свой URL API.
# Один и тот же код — различается только REACT_APP_API_URL.

# --- LOCAL (разработка) ---
# REACT_APP_API_URL=http://localhost:8000

# --- PRODUCTION (сборка для сервера) ---
# REACT_APP_API_URL=https://api.твой-домен.ru

# Используемое значение (раскомментируй нужное или задай здесь):
REACT_APP_API_URL=http://localhost:8000
