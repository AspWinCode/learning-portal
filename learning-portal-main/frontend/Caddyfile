# Один сайт — только https://... (Caddy сам поднимет :80 и редирект на HTTPS)
# "ambiguous site definition" бывает, если один домен в двух блоках — здесь блок один.
https://{$DOMAIN} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}


