# Frontend: скопируй в .env и подставь свой URL API.
# Vite предпочитает VITE_API_URL, но для обратной совместимости
# приложение также читает REACT_APP_API_URL.

# --- LOCAL (разработка) ---
# VITE_API_URL=http://localhost:8000
# VITE_DEV_API_PROXY=http://localhost:8000

# --- PRODUCTION (сборка для сервера) ---
# VITE_API_URL=https://api.твой-домен.ru

# Используемое значение (раскомментируй нужное или задай здесь):
VITE_API_URL=http://localhost:8000
