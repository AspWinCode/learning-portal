# Backend: скопируй в .env и подставь свои значения.
# Один и тот же код — различаются только значения ниже для локальной разработки и продакшена.

# --- LOCAL (разработка) ---
# DATABASE_URL=postgresql://learning_user:ТВОЙ_ПАРОЛЬ@localhost:5432/learning_portal
# SECRET_KEY=  # Required, minimum 32 chars. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# APP_ENV=development

# --- PRODUCTION (сервер) ---
# DATABASE_URL=postgresql://learning_user:ПАРОЛЬ@db:5432/learning_portal
# SECRET_KEY=длинный-секретный-ключ-не-менее-32-символов
# CORS_ORIGINS=https://твой-домен.ru
# APP_ENV=production

# --- Точка Банк (выписки, привязка платежей к ученикам) ---
# Получить в личном кабинете Точка: Интеграции / API. Не коммитить .env в git.
# TOCHKA_CLIENT_ID=ваш_client_id
# TOCHKA_CLIENT_SECRET=ваш_client_secret
# TOCHKA_ACCOUNT_ID=  (обязательно для автозачисления: id счёта в Точка Банк для выписки; без него авто-импорт раз в 10 мин не запускается)

# Используемые переменные (раскомментируй и заполни один из блоков выше или задай здесь):
DATABASE_URL=postgresql://learning_user:change_me_strong_password@localhost:5432/learning_portal
SECRET_KEY=change_me_minimum_32_characters_long
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXY_IPS=172.16.0.0/12

# Точка Банк (опционально): раскомментируй и подставь значения из ЛК Точка. Не коммитить .env.
# TOCHKA_CLIENT_ID=
# TOCHKA_CLIENT_SECRET=
# TOCHKA_ACCOUNT_ID=
