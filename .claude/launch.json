{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "venv312\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000", "--ws", "none"],
      "port": 8000,
      "cwd": "backend"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000,
      "cwd": "frontend"
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "port": 4173,
      "cwd": "frontend"
    },
    {
      "name": "academy-site-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5050", "--directory", "C:/Users/direc/AppData/Local/Temp/site_preview"],
      "port": 5050
    },
    {
      "name": "kodex-onboarding",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "4173", "."],
      "port": 4173,
      "cwd": "kodex_onboarding"
    }
  ]
}
